# Скопируйте этот файл в .env и заполните нужные значения.
# Локально сервер подхватывает .env автоматически при старте.
# На Vercel эти же переменные задаются в Project Settings → Environment Variables.

# Строка подключения к Supabase Postgres (Project Settings → Database → Connection string → URI,
# режим "Transaction pooler", порт 6543 — важно для serverless).
# Можно использовать существующий проект Supabase — таблицы трекера живут в отдельной
# схеме "kkal" и не пересекаются с другими данными в той же базе.
DATABASE_URL=

# Токен Vercel Blob для хранения фото веса (Storage → Blob → Create → Read/Write Token)
BLOB_READ_WRITE_TOKEN=

# Какой провайдер использовать для распознавания фото: openai | gemini | grok | anthropic
AI_PROVIDER=openai

# Ключ нужен только для выбранного провайдера
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=

# Необязательно: конкретная модель (по умолчанию используется разумное значение для провайдера)
AI_MODEL=

# Необязательно: порт локального сервера
PORT=4173
